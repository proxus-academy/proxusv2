# syntax=docker/dockerfile:1
FROM node:22.22.2-bookworm-slim AS build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@10.32.1 --activate
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @proxus/web build \
 && VITE_PREVIEW_ADMIN_AUTO_LOGIN=true VITE_PREVIEW_ADMIN_EMAIL=admin.qa@proxus.dev VITE_PREVIEW_ADMIN_PASSWORD='Proxus-QA-dev-2026!' pnpm --filter @proxus/admin exec vite build --base=/admin/ \
 && pnpm --filter @proxus/storybook build \
 && node scripts/build-preview-artifact.mjs

FROM node:22.22.2-bookworm-slim AS runtime
ENV NODE_ENV=production
ENV DATABASE_MIGRATIONS_DIR=/app/drizzle
ENV WEB_ROOT=/app/web
ENV ADMIN_ROOT=/app/admin
ENV UI_ROOT=/app/ui
WORKDIR /app
COPY --from=build --chown=node:node /workspace/dist/preview-runtime/ /app/
USER node
EXPOSE 8080
CMD ["node", "/app/api.mjs"]
