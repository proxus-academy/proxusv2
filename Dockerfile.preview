# syntax=docker/dockerfile:1
FROM node:22.22.2-bookworm-slim AS build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@10.32.1 --activate
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
RUN pnpm fetch
COPY . .
# The Effect TypeScript language-service patch is required by diagnostics, not by Vite/esbuild bundling.
RUN pnpm install --offline --frozen-lockfile --ignore-scripts
RUN pnpm --filter @proxus/web build & web_pid=$!; \
    pnpm --filter @proxus/ugc build & ugc_pid=$!; \
    VITE_PREVIEW_ADMIN_AUTO_LOGIN=true VITE_PREVIEW_ADMIN_EMAIL=admin.qa@proxus.dev VITE_PREVIEW_ADMIN_PASSWORD='Proxus-QA-dev-2026!' pnpm --filter @proxus/admin exec vite build --base=/admin/ & admin_pid=$!; \
    pnpm --filter @proxus/storybook build & storybook_pid=$!; \
    wait "$web_pid" && wait "$ugc_pid" && wait "$admin_pid" && wait "$storybook_pid" \
 && node scripts/build-preview-artifact.mjs

FROM node:22.22.2-bookworm-slim AS runtime
ENV NODE_ENV=production
ENV DATABASE_MIGRATIONS_DIR=/app/drizzle
ENV WEB_ROOT=/app/web
ENV ADMIN_ROOT=/app/admin
ENV UGC_ROOT=/app/ugc
ENV UI_ROOT=/app/ui
WORKDIR /app
COPY --from=build --chown=node:node /workspace/dist/preview-runtime/ /app/
USER node
EXPOSE 8080
CMD ["node", "/app/api.mjs"]
