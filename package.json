{
  "name": "proxus-v2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names dev-server,web,admin \"pnpm --filter @proxus/dev-server dev\" \"pnpm --filter @proxus/web dev\" \"pnpm --filter @proxus/admin dev\"",
    "dev:admin": "concurrently --kill-others-on-fail --names dev-server,admin \"pnpm --filter @proxus/dev-server dev\" \"pnpm --filter @proxus/admin dev\"",
    "dev:web": "concurrently --kill-others-on-fail --names dev-server,web \"pnpm --filter @proxus/dev-server dev\" \"pnpm --filter @proxus/web dev\"",
    "dev:server": "pnpm --filter @proxus/dev-server dev",
    "dev:admin-server": "pnpm --filter @proxus/dev-server dev",
    "preview:artifact": "pnpm --filter @proxus/web build && pnpm --filter @proxus/admin exec vite build --base=/admin/ && pnpm --filter @proxus/storybook build && node scripts/build-preview-artifact.mjs",
    "preview:up": "docker compose -f compose.preview.yml up --build -d",
    "preview:smoke": "node scripts/preview-smoke.mjs",
    "preview:down": "docker compose -f compose.preview.yml down --volumes --remove-orphans",
    "preview:lifecycle": "node scripts/preview-lifecycle.mjs",
    "dev:admin-front": "pnpm --filter @proxus/admin dev",
    "dev:web-front": "pnpm --filter @proxus/web dev",
    "dev:api": "pnpm dev:server",
    "dev:admin-api": "pnpm dev:admin-server",
    "dev:storybook": "pnpm --filter @proxus/storybook storybook",
    "auth:qa:seed": "PGLITE_DATA_DIR=../../apps/dev-server/.data pnpm --filter @proxus/backend-infra auth:qa:seed",
    "auth:qa:list": "PGLITE_DATA_DIR=../../apps/dev-server/.data pnpm --filter @proxus/backend-infra auth:qa:list",
    "db:dev:seed": "PGLITE_DATA_DIR=../../apps/dev-server/.data pnpm --filter @proxus/backend-infra db:seed:pglite && pnpm auth:qa:seed",
    "db:dev:reset": "PGLITE_DATA_DIR=../../apps/dev-server/.data pnpm --filter @proxus/backend-infra db:reset:pglite && pnpm auth:qa:seed",
    "dev:motel": "motel",
    "motel:daemon": "motel daemon",
    "motel:status": "motel status",
    "motel:stop": "motel stop",
    "build:storybook": "pnpm --filter @proxus/storybook build-storybook",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:ci": "turbo run test --concurrency=1",
    "check": "pnpm typecheck && pnpm build",
    "effect:diagnostics": "node scripts/run-effect-diagnostics.mjs",
    "lint": "pnpm lint:eslint && pnpm lint:anti-slop",
    "lint:eslint": "eslint \"apps/**/*.{js,mjs,ts,tsx}\" \"packages/*/**/*.{ts,tsx}\" --no-error-on-unmatched-pattern --no-warn-ignored --max-warnings 0",
    "lint:anti-slop": "oxlint --config oxlint.config.ts apps packages --quiet",
    "boundaries": "depcruise --config dependency-cruiser.config.mjs apps packages",
    "knip": "knip --config knip.json --no-progress",
    "workspace:contracts": "node scripts/check-workspace-contracts.mjs",
    "static": "pnpm effect:diagnostics && pnpm typecheck && pnpm lint && pnpm boundaries && pnpm knip && pnpm workspace:contracts",
    "validate:self-test": "node scripts/validation-self-test.mjs",
    "validate:pr": "pnpm validate:self-test && pnpm static && pnpm test:ci && pnpm build",
    "postinstall": "effect-language-service patch"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.0",
    "@kitlangton/motel": "0.2.6",
    "@oxlint/plugins": "1.78.0",
    "concurrently": "^9.2.4",
    "dependency-cruiser": "18.1.0",
    "eslint": "10.7.0",
    "esbuild": "0.25.12",
    "knip": "6.27.0",
    "oxlint": "1.78.0",
    "turbo": "^2.10.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.64.0"
  }
}
