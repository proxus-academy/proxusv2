{
  "name": "proxus-v2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names server,admin-server,web,mobile-web,admin \"pnpm --filter @proxus/server dev\" \"pnpm --filter @proxus/admin-server dev\" \"pnpm --filter @proxus/web dev\" \"pnpm --filter @proxus/mobile-web dev\" \"pnpm --filter @proxus/admin dev\"",
    "dev:admin": "concurrently --kill-others-on-fail --names server,admin-server,admin \"pnpm --filter @proxus/server dev\" \"pnpm --filter @proxus/admin-server dev\" \"pnpm --filter @proxus/admin dev\"",
    "dev:web": "concurrently --kill-others-on-fail --names server,web \"pnpm --filter @proxus/server dev\" \"pnpm --filter @proxus/web dev\"",
    "dev:mobile-web": "concurrently --kill-others-on-fail --names server,mobile-web \"pnpm --filter @proxus/server dev\" \"pnpm --filter @proxus/mobile-web dev\"",
    "dev:web-mobile": "concurrently --kill-others-on-fail --names server,web,mobile-web \"pnpm --filter @proxus/server dev\" \"pnpm --filter @proxus/web dev\" \"pnpm --filter @proxus/mobile-web dev\"",
    "dev:server": "pnpm --filter @proxus/server dev",
    "dev:admin-server": "pnpm --filter @proxus/admin-server dev",
    "dev:admin-front": "pnpm --filter @proxus/admin dev",
    "dev:web-front": "pnpm --filter @proxus/web dev",
    "dev:mobile-web-front": "pnpm --filter @proxus/mobile-web dev",
    "dev:api": "pnpm dev:server",
    "dev:admin-api": "pnpm dev:admin-server",
    "dev:storybook": "pnpm --filter @proxus/storybook storybook",
    "auth:qa:seed": "pnpm --filter @proxus/backend-infra auth:qa:seed",
    "auth:qa:list": "pnpm --filter @proxus/backend-infra auth:qa:list",
    "dev:motel": "motel",
    "motel:daemon": "motel daemon",
    "motel:status": "motel status",
    "motel:stop": "motel stop",
    "build:storybook": "pnpm --filter @proxus/storybook build-storybook",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:ci": "turbo run test --concurrency=1",
    "check": "pnpm typecheck && pnpm build",
    "effect:diagnostics": "node scripts/run-effect-diagnostics.mjs",
    "lint": "eslint \"apps/*/**/*.{ts,tsx}\" \"packages/*/**/*.{ts,tsx}\" --no-error-on-unmatched-pattern --no-warn-ignored --max-warnings 0",
    "boundaries": "depcruise --config dependency-cruiser.config.mjs apps packages",
    "knip": "knip --config knip.json --no-progress",
    "workspace:contracts": "node scripts/check-workspace-contracts.mjs",
    "static": "pnpm effect:diagnostics && pnpm typecheck && pnpm lint && pnpm boundaries && pnpm knip && pnpm workspace:contracts",
    "validate:self-test": "node scripts/validation-self-test.mjs",
    "validate:pr": "pnpm validate:self-test && pnpm static && pnpm test:ci && pnpm build",
    "postinstall": "effect-language-service patch"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.0",
    "@kitlangton/motel": "0.2.6",
    "concurrently": "^9.2.4",
    "dependency-cruiser": "18.1.0",
    "eslint": "10.7.0",
    "knip": "6.27.0",
    "turbo": "^2.10.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.64.0"
  }
}