{
  "name": "proxus-v2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @proxus/server --filter @proxus/admin-server --filter @proxus/web --filter @proxus/mobile-web --filter @proxus/admin dev",
    "dev:admin": "pnpm -r --parallel --filter @proxus/server --filter @proxus/admin-server --filter @proxus/admin dev",
    "dev:web": "pnpm -r --parallel --filter @proxus/server --filter @proxus/web dev",
    "dev:mobile-web": "pnpm -r --parallel --filter @proxus/server --filter @proxus/mobile-web dev",
    "dev:web-mobile": "pnpm -r --parallel --filter @proxus/server --filter @proxus/web --filter @proxus/mobile-web dev",
    "dev:server": "pnpm --filter @proxus/server dev",
    "dev:admin-server": "pnpm --filter @proxus/admin-server dev",
    "dev:admin-front": "pnpm --filter @proxus/admin dev",
    "dev:web-front": "pnpm --filter @proxus/web dev",
    "dev:mobile-web-front": "pnpm --filter @proxus/mobile-web dev",
    "dev:api": "pnpm dev:server",
    "dev:admin-api": "pnpm dev:admin-server",
    "dev:storybook": "pnpm --filter @proxus/storybook storybook",
    "dev:motel": "motel",
    "motel:daemon": "motel daemon",
    "motel:status": "motel status",
    "motel:stop": "motel stop",
    "build:storybook": "pnpm --filter @proxus/storybook build-storybook",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm build",
    "effect:diagnostics": "effect-language-service diagnostics --project packages/shared/tsconfig.json --strict && effect-language-service diagnostics --project packages/backend-domain/tsconfig.json --strict && effect-language-service diagnostics --project packages/backend-infra/tsconfig.json --strict && effect-language-service diagnostics --project packages/backend-transport/tsconfig.json --strict && effect-language-service diagnostics --project packages/backend-admin-transport/tsconfig.json --strict && effect-language-service diagnostics --project apps/server/tsconfig.json --strict && effect-language-service diagnostics --project apps/admin-server/tsconfig.json --strict",
    "postinstall": "effect-language-service patch"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.0",
    "@kitlangton/motel": "0.2.6",
    "typescript": "^5.8.3"
  }
}