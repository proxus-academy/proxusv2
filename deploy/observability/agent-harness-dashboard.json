{"title":"Proxus Agent Harness","uid":"proxus-agent-harness","schemaVersion":39,"timezone":"utc","refresh":"30s","tags":["agent-harness"],"templating":{"list":[{"name":"environment","type":"query","query":"label_values(agent_runs_total, deployment_environment)","includeAll":false}]},"panels":[{"id":1,"title":"Run outcomes (5m)","type":"timeseries","targets":[{"expr":"sum by (outcome) (rate(agent_runs_total{deployment_environment=\"$environment\"}[5m]))","legendFormat":"{{outcome}}"}]},{"id":2,"title":"Run p95 latency","type":"timeseries","targets":[{"expr":"histogram_quantile(0.95, sum by (le) (rate(agent_run_duration_seconds_bucket{deployment_environment=\"$environment\"}[5m])))","legendFormat":"p95"}]},{"id":3,"title":"Queue oldest age","type":"stat","targets":[{"expr":"max(agent_run_queue_oldest_age_seconds{deployment_environment=\"$environment\"})"}]},{"id":4,"title":"Token usage","type":"timeseries","targets":[{"expr":"sum by (direction) (rate(agent_tokens_total{deployment_environment=\"$environment\"}[5m]))","legendFormat":"{{direction}}"}]},{"id":5,"title":"DSL outcomes","type":"timeseries","targets":[{"expr":"sum by (operation,outcome) (rate(agent_dsl_operations_total{deployment_environment=\"$environment\"}[5m]))","legendFormat":"{{operation}} {{outcome}}"}]},{"id":6,"title":"Children per run","type":"timeseries","targets":[{"expr":"histogram_quantile(0.95, sum by (le) (rate(agent_run_children_bucket{deployment_environment=\"$environment\"}[5m])))","legendFormat":"p95"}]},{"id":7,"title":"Approval p95 latency","type":"timeseries","targets":[{"expr":"histogram_quantile(0.95, sum by (le) (rate(agent_approval_wait_seconds_bucket{deployment_environment=\"$environment\"}[5m])))","legendFormat":"p95"}]},{"id":8,"title":"Sandbox failures","type":"timeseries","targets":[{"expr":"sum(rate(agent_sandbox_processes_total{deployment_environment=\"$environment\",outcome=\"failed\"}[5m]))"}]}]}
