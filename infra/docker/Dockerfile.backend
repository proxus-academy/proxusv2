# syntax=docker/dockerfile:1
FROM node:22.22.2-bookworm-slim@sha256:9f6d5975c7dca860947d3915877f85607946403fc55349f39b4bc3688448bb6e AS build
ARG SOURCE_SHA
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
WORKDIR /workspace
RUN test -n "$SOURCE_SHA"
RUN corepack enable && corepack prepare pnpm@10.32.1 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/server/package.json apps/server/package.json
COPY apps/admin-server/package.json apps/admin-server/package.json
COPY packages/backend-admin-transport/package.json packages/backend-admin-transport/package.json
COPY packages/backend-domain/package.json packages/backend-domain/package.json
COPY packages/backend-infra/package.json packages/backend-infra/package.json
COPY packages/backend-transport/package.json packages/backend-transport/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY infra/package.json infra/package.json
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY apps/server apps/server
COPY apps/admin-server apps/admin-server
COPY packages/backend-admin-transport packages/backend-admin-transport
COPY packages/backend-domain packages/backend-domain
COPY packages/backend-infra packages/backend-infra
COPY packages/backend-transport packages/backend-transport
COPY packages/shared packages/shared
COPY infra infra
RUN pnpm --filter @proxus/infra build:backend
RUN ! grep -R -E '@electric-sql/pglite|@effect/sql-pglite|PGLITE_DATA_DIR|dev-server|src/database/pglite' dist/production-backend/*.mjs

FROM node:22.22.2-bookworm-slim@sha256:9f6d5975c7dca860947d3915877f85607946403fc55349f39b4bc3688448bb6e AS runtime
ARG SOURCE_SHA
ENV NODE_ENV=production
LABEL org.opencontainers.image.revision=$SOURCE_SHA
WORKDIR /app
COPY --from=build --chown=node:node /workspace/dist/production-backend/ /app/
USER node

FROM runtime AS server
CMD ["node", "/app/server.mjs"]

FROM runtime AS admin-server
CMD ["node", "/app/admin-server.mjs"]
