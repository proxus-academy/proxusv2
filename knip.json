{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "*.config.mjs"],
      "project": ["scripts/*.mjs", "*.config.mjs"],
      // Installed by the trusted GitHub workflow and developer Google Cloud SDK, not pnpm.
      "ignoreBinaries": ["gcloud"]
    },
    "apps/admin": {},
    "apps/preview-server": {
      "entry": ["src/initialize.ts"]
    },
    "apps/storybook": {
      // Effect is used by app-owned stories outside this workspace's source tree.
      // Tailwind is resolved indirectly by Storybook's Vite plugin and shared theme CSS.
      "ignoreDependencies": ["@effect/atom-react", "effect", "tailwindcss"]
    },
    "apps/web": {
      // Tailwind is resolved indirectly by Vite/shared theme CSS. Paraglide's
      // generated module surface intentionally exports framework-neutral helpers.
      "ignoreDependencies": ["tailwindcss"],
      "ignore": ["src/paraglide/**"]
    },
    "apps/*": {},
    "packages/*": {}
  }
}
