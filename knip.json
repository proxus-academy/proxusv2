{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "*.config.mjs"],
      "project": ["scripts/*.mjs", "*.config.mjs"]
    },
    "apps/admin": {
      // Loaded only by Vite's inline development bootstrap in index.html.
      "ignoreDependencies": ["react-grab"]
    },
    "apps/storybook": {
      // Effect/shared are used by app-owned stories outside this workspace's source tree.
      // Tailwind is resolved indirectly by Storybook's Vite plugin and shared theme CSS.
      "ignoreDependencies": ["@effect/atom-react", "@proxus/shared", "effect", "tailwindcss"]
    },
    "apps/web": {
      // react-grab comes from index.html; Tailwind is resolved indirectly by Vite/shared theme CSS.
      "ignoreDependencies": ["react-grab", "tailwindcss"]
    },
    "apps/*": {},
    "packages/*": {}
  }
}
