{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["PUBLIC_*", "VITE_*"],
      "outputs": []
    },
    "@proxus/admin#build": {
      "dependsOn": ["^build"],
      "env": ["PUBLIC_*", "VITE_*"],
      "outputs": ["dist/**"]
    },
    "@proxus/mobile-web#build": {
      "dependsOn": ["^build"],
      "env": ["PUBLIC_*", "VITE_*"],
      "outputs": ["dist/**"]
    },
    "@proxus/storybook#build": {
      "dependsOn": ["^build"],
      "env": ["PUBLIC_*", "VITE_*"],
      "outputs": ["storybook-static/**"]
    },
    "@proxus/web#build": {
      "dependsOn": ["^build"],
      "env": ["PUBLIC_*", "VITE_*"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
