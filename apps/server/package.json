{
  "name": "@proxus/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/dev.ts",
    "start": "tsx src/prod.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:check:postgres": "tsx src/infrastructure/database/check.postgres.ts",
    "db:migrate": "tsx src/infrastructure/database/migrate.ts",
    "db:migrate:pglite": "tsx src/infrastructure/database/migrate.ts",
    "db:migrate:postgres": "tsx src/infrastructure/database/migrate.postgres.ts",
    "db:seed:pglite": "tsx src/infrastructure/database/seed.pglite.ts",
    "db:reset:pglite": "tsx src/infrastructure/database/reset.pglite.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.98",
    "@effect/sql-pg": "4.0.0-beta.98",
    "@effect/sql-pglite": "4.0.0-beta.98",
    "@electric-sql/pglite": "0.5.4",
    "@proxus/shared": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.0-beta.98",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/pg": "8.15.5",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "3.2.7"
  }
}