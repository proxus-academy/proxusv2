---
import { getCollection } from "astro:content"
import SiteLayout from "../../layouts/SiteLayout.astro"
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
---
<SiteLayout title="Blog de Proxus" description="Guías y recursos para estudiar mejor, preparar exámenes y aprovechar tus herramientas de aprendizaje."><section class="page-hero"><div class="container"><span class="eyebrow">Blog</span><h1>Ideas para estudiar mejor</h1><p>Guías prácticas, métodos de estudio y recursos para sacar más partido a tu tiempo.</p></div></section><section class="post-list">{posts.map(post => <article class="post-card"><time datetime={post.data.publishedAt.toISOString()}>{post.data.publishedAt.toLocaleDateString("es-ES",{dateStyle:"long"})}</time><h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2><p>{post.data.description}</p><a href={`/blog/${post.id}/`}><strong>Leer artículo →</strong></a></article>)}</section></SiteLayout>
