{
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    "overrides": [
      {
        "files": ["src/routes/**/*.tsx"],
        "rules": ["react-doctor/only-export-components"]
      },
      {
        "files": ["package.json"],
        "rules": ["react-doctor/unused-dev-dependency"]
      }
    ]
  }
}
