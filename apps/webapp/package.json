{
  "name": "@proxus/webapp",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "node ../../scripts/validate-public-config.mjs webapp && vite build",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations",
    "typecheck": "pnpm paraglide && tsc --noEmit",
    "test": "pnpm paraglide && vitest run"
  },
  "dependencies": {
    "@effect/atom-react": "4.0.0-beta.98",
    "@inlang/paraglide-js": "2.24.1",
    "@lucas-barake/effect-form-react": "0.26.0-beta.5",
    "@proxus/assets": "workspace:*",
    "@proxus/frontend-core": "workspace:*",
    "@proxus/product-messages": "workspace:*",
    "@proxus/shared": "workspace:*",
    "@proxus/ui": "workspace:*",
    "@tanstack/react-router": "1.170.30",
    "effect": "4.0.0-beta.98",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/router-plugin": "1.168.33",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "happy-dom": "^18.0.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.8.3",
    "vite": "^7.2.7",
    "vitest": "3.2.7"
  }
}
