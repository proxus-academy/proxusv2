{
  "name": "@proxus/site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 4321",
    "paraglide": "paraglide-js compile --project ../../project.inlang --outdir ./src/paraglide --emit-ts-declarations --strategy url,globalVariable,baseLocale",
    "build": "pnpm paraglide && astro check && astro build",
    "typecheck": "pnpm paraglide && astro check",
    "test": "pnpm paraglide && vitest run"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.24.1",
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.1",
    "sharp": "^0.35.3",
    "typescript": "^5.8.3",
    "vitest": "3.2.7"
  }
}
