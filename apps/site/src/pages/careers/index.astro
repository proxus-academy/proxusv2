---
import SiteLayout from "../../layouts/SiteLayout.astro"
import * as m from "../../paraglide/messages.js"
const careersHref = `mailto:soporte@proxus.es?subject=${encodeURIComponent(m.site_careersSubject())}`
---
<SiteLayout title={m.site_careersTitle()} description={m.site_careersDescription()}><section class="page-hero"><div class="container"><span class="eyebrow">{m.site_team()}</span><h1>{m.site_careersHeading()}</h1><p>{m.site_careersIntro()}</p></div></section><section class="section"><div class="container"><div class="cta"><h2>{m.site_joinQuestion()}</h2><p>{m.site_joinDescription()}</p><div class="hero-actions"><a class="button" href={careersHref}>{m.site_apply()}</a></div></div></div></section></SiteLayout>
