---
import SiteLayout from "../layouts/SiteLayout.astro"
import * as m from "../paraglide/messages.js"
const supportHref = `mailto:soporte@proxus.es?subject=${encodeURIComponent(m.site_supportSubject())}`
---
<SiteLayout title={m.site_supportTitle()} description={m.site_supportDescription()}><section class="page-hero"><div class="container"><span class="eyebrow">{m.site_support()}</span><h1>{m.site_supportHeading()}</h1><p>{m.site_supportIntro()}</p></div></section><div class="prose"><div class="card"><h2>{m.site_talkToSupport()}</h2><p>{m.site_supportInstructions()}</p><p><a class="button" href={supportHref}>{m.site_sendRequest()}</a></p></div></div></SiteLayout>
