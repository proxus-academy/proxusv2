---
import SiteLayout from "../layouts/SiteLayout.astro"
import * as m from "../paraglide/messages.js"
import { getLocale } from "../paraglide/runtime.js"
import { resolveProductUrl, toSiteLocale } from "../site-config"
const locale = toSiteLocale(getLocale())
const productUrl = resolveProductUrl(import.meta.env.PUBLIC_PRODUCT_URL, locale)
const plans = [
  { name: m.site_free(), price: "0 €", description: m.site_freeDescription(), features: [m.site_freeFeatureAccount(), m.site_freeFeatureTools(), m.site_freeFeatureOrganize()] },
  { name: "Magia", price: m.site_checkInApp(), description: m.site_magicDescription(), features: [m.site_moreGenerations(), m.site_testsAndFlashcards(), m.site_podcastsAndNotes(), m.site_studyFolders()], featured: true },
  { name: "Supermagia", price: m.site_checkInApp(), description: m.site_supermagicDescription(), features: [m.site_everythingMagic(), m.site_moreCapacity(), m.site_advancedTools(), m.site_priorityExperience()] },
]
---
<SiteLayout title={m.site_pricingTitle()} description={m.site_pricingDescription()}>
<section class="page-hero"><div class="container"><span class="eyebrow">{m.site_plans()}</span><h1>{m.site_pricingHeading()}</h1><p>{m.site_pricingIntro()}</p></div></section>
<section class="section"><div class="container grid-3 pricing-grid">{plans.map(plan => <article class:list={["card","price-card",{"featured":plan.featured}]}><span class="eyebrow">{plan.name}</span><p class="price">{plan.price}</p><p>{plan.description}</p><ul class="feature-list">{plan.features.map(feature => <li>{feature}</li>)}</ul><a class="button" href={productUrl}>{m.site_start()}</a></article>)}</div></section>
</SiteLayout>
