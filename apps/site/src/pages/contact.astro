---
import SiteLayout from "../layouts/SiteLayout.astro"
import * as m from "../paraglide/messages.js"
---
<SiteLayout title={m.site_contactTitle()} description={m.site_contactDescription()}><section class="page-hero"><div class="container"><span class="eyebrow">{m.site_contact()}</span><h1>{m.site_contactHeading()}</h1><p>{m.site_contactIntro()}</p></div></section><div class="prose"><div class="card"><h2>{m.site_generalContact()}</h2><p>{m.site_generalContactDescription()}</p><p><a class="button" href="mailto:soporte@proxus.es">soporte@proxus.es</a></p></div></div></SiteLayout>
