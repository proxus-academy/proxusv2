---
import { getCollection, render } from "astro:content"
import SiteLayout from "../../../layouts/SiteLayout.astro"
import * as m from "../../../paraglide/messages.js"
export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft)
  const englishPosts = posts.filter(post => post.data.locale === "en")
  return englishPosts.map(post => {
    const spanishPost = posts.find(candidate => candidate.data.locale === "es" && candidate.data.translationKey === post.data.translationKey)
    return {
      params: { id: post.id.replace(/^en\//, "") },
      props: { post, spanishId: spanishPost?.id },
    }
  })
}
const { post, spanishId } = Astro.props
const { Content } = await render(post)
---
<SiteLayout title={`${post.data.title} — Proxus`} description={post.data.description} image={post.data.image ?? "/social-card.svg"} alternatePaths={{ en: `blog/${post.id.replace(/^en\//, "")}`, ...(spanishId ? { es: `blog/${spanishId}` } : {}) }}><article><header class="page-hero"><div class="container"><span class="eyebrow">{m.site_studyGuide()}</span><h1>{post.data.title}</h1><p>{post.data.description}</p></div></header><div class="prose"><Content /></div></article></SiteLayout>
