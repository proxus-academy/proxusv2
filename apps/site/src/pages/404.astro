---
import SiteLayout from "../layouts/SiteLayout.astro"
import * as m from "../paraglide/messages.js"
---
<SiteLayout title={m.site_notFoundTitle()} description={m.site_notFoundDescription()} noindex><section class="page-hero"><div class="container"><span class="eyebrow">Error 404</span><h1>{m.site_notFoundHeading()}</h1><p>{m.site_notFoundIntro()}</p><div class="hero-actions"><a class="button" href="/">{m.site_backHome()}</a></div></div></section></SiteLayout>
