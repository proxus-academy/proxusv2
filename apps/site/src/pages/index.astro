---
import SiteLayout from "../layouts/SiteLayout.astro"
import * as m from "../paraglide/messages.js"
import { getLocale } from "../paraglide/runtime.js"
import { resolveProductUrl, toSiteLocale } from "../site-config"
const locale = toSiteLocale(getLocale())
const productUrl = resolveProductUrl(import.meta.env.PUBLIC_PRODUCT_URL, locale)
const tools = [
  ["🧠", m.site_toolTestsTitle(), m.site_toolTestsDescription()],
  ["⚡", m.site_toolFlashcardsTitle(), m.site_toolFlashcardsDescription()],
  ["🎧", m.site_toolPodcastsTitle(), m.site_toolPodcastsDescription()],
  ["📝", m.site_toolNotesTitle(), m.site_toolNotesDescription()],
  ["🧩", m.site_toolExercisesTitle(), m.site_toolExercisesDescription()],
  ["💬", m.site_toolChatTitle(), m.site_toolChatDescription()],
]
const faqs = [
  [m.site_faqWhatQuestion(), m.site_faqWhatAnswer()],
  [m.site_faqFreeQuestion(), m.site_faqFreeAnswer()],
  [m.site_faqFilesQuestion(), m.site_faqFilesAnswer()],
  [m.site_faqMobileQuestion(), m.site_faqMobileAnswer()],
]
---
<SiteLayout title={m.site_homeTitle()} description={m.site_homeDescription()}>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify({"@context":"https://schema.org","@type":"SoftwareApplication",name:"Proxus",applicationCategory:"EducationalApplication",operatingSystem:"Web, iOS, Android",inLanguage:locale,offers:{"@type":"Offer",price:"0",priceCurrency:"EUR"}})} />
  <section class="hero">
    <div class="container">
      <span class="eyebrow">{m.site_homeEyebrow()}</span>
      <h1>{m.site_homeHeadingStart()} <span class="gradient-text">{m.site_homeHeadingHighlight()}</span></h1>
      <p class="hero-copy">{m.site_homeIntro()}</p>
      <div class="hero-actions"><a class="button" href={productUrl}>{m.site_startFree()}</a><a class="button button-secondary" href="#como-funciona">{m.site_discoverHow()}</a></div>
      <p class="trust">{m.site_homeTrust()}</p>
      <div class="product-preview" aria-label={m.site_previewLabel()}>
        <div class="preview-bar"><i></i><i></i><i></i></div>
        <div class="preview-body"><aside class="preview-sidebar"><strong>{m.site_previewSubject()}</strong><span>{m.site_previewSummary()}</span><span>{m.site_previewPracticeTest()}</span><span>{m.site_previewFlashcards()}</span><span>{m.site_previewPodcast()}</span></aside><div class="preview-content"><div class="preview-card"><span class="eyebrow">{m.site_previewProgress()}</span><h3>{m.site_previewMastery()}</h3><p>{m.site_previewAdvice()}</p><div class="progress"><span></span></div></div></div></div>
      </div>
    </div>
  </section>
  <section class="section section-alt" id="como-funciona"><div class="container"><div class="section-heading"><span class="eyebrow">{m.site_easyEyebrow()}</span><h2>{m.site_easyTitle()}</h2><p>{m.site_easyDescription()}</p></div><div class="grid-3 steps"><article class="card step"><h3>{m.site_stepFolderTitle()}</h3><p>{m.site_stepFolderDescription()}</p></article><article class="card step"><h3>{m.site_stepMaterialTitle()}</h3><p>{m.site_stepMaterialDescription()}</p></article><article class="card step"><h3>{m.site_stepPracticeTitle()}</h3><p>{m.site_stepPracticeDescription()}</p></article></div></div></section>
  <section class="section" id="herramientas"><div class="container"><div class="section-heading"><span class="eyebrow">{m.site_tools()}</span><h2>{m.site_toolsTitle()}</h2><p>{m.site_toolsDescription()}</p></div><div class="grid-3">{tools.map(([icon,title,text]) => <article class="card"><span class="card-icon" aria-hidden="true">{icon}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
  <section class="section section-alt"><div class="container"><div class="section-heading"><span class="eyebrow">{m.site_students()}</span><h2>{m.site_studentsTitle()}</h2></div><div class="grid-3"><blockquote class="card quote">{m.site_quoteMedicine()}<footer>{m.site_quoteMedicineAuthor()}</footer></blockquote><blockquote class="card quote">{m.site_quoteLaw()}<footer>{m.site_quoteLawAuthor()}</footer></blockquote><blockquote class="card quote">{m.site_quotePsychology()}<footer>{m.site_quotePsychologyAuthor()}</footer></blockquote></div></div></section>
  <section class="section"><div class="container"><div class="section-heading"><span class="eyebrow">{m.site_faqEyebrow()}</span><h2>{m.site_faqTitle()}</h2></div><div class="faq-list">{faqs.map(([question,answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></div></section>
  <section class="section"><div class="container cta"><span class="eyebrow">{m.site_ctaEyebrow()}</span><h2>{m.site_ctaTitle()}</h2><p>{m.site_ctaDescription()}</p><div class="hero-actions"><a class="button" href={productUrl}>{m.site_createAccount()}</a></div></div></section>
</SiteLayout>
