{
  "name": "@proxus/product-i18n",
  "private": true,
  "type": "module",
  "exports": {
    "./messages": "./src/paraglide/messages.js",
    "./runtime": "./src/paraglide/runtime.js"
  },
  "scripts": {
    "generate": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations --strategy baseLocale",
    "build": "pnpm generate",
    "typecheck": "pnpm generate && tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.22.0",
    "typescript": "^5.8.3",
    "vitest": "3.2.7"
  }
}
