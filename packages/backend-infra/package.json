{
  "name": "@proxus/backend-infra",
  "private": true,
  "type": "module",
  "exports": {
    "./database/pglite": "./src/database/pglite.ts",
    "./database/postgres": "./src/database/postgres.ts",
    "./database/preview-initialize": "./src/database/preview-initialize.ts",
    "./auth": "./src/modules/auth/index.ts",
    "./auth/preview-runtime": "./src/modules/auth/preview-runtime.ts",
    "./auth/authentication-live": "./src/modules/auth/authentication.live.ts",
    "./auth/google-fake": "./src/modules/auth/google.fake.ts",
    "./auth/google-security-live": "./src/modules/auth/google.security.live.ts",
    "./auth/google-session-live": "./src/modules/auth/google.session.live.ts",
    "./auth-qa": "./src/auth-qa/fixtures.ts",
    "./access-control/pglite": "./src/modules/access-control/repository.pglite.layer.ts",
    "./access-control/postgres": "./src/modules/access-control/repository.postgres.layer.ts",
    "./feature-flags/pglite": "./src/modules/feature-flags/repository.pglite.layer.ts",
    "./feature-flags/postgres": "./src/modules/feature-flags/repository.postgres.layer.ts",
    "./study-catalog/pglite": "./src/modules/study-catalog/repository.pglite.layer.ts",
    "./study-catalog/postgres": "./src/modules/study-catalog/repository.postgres.layer.ts",
    "./product-analytics/memory": "./src/modules/product-analytics/repository.memory.ts",
    "./product-analytics/pglite": "./src/modules/product-analytics/repository.pglite.layer.ts",
    "./product-analytics/bigquery": "./src/modules/product-analytics/repository.bigquery.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'src/postgres/**' --no-file-parallelism --maxWorkers=1",
    "test:postgres": "node -e \"if (!process.env.DATABASE_URL) throw new Error('DATABASE_URL is required for test:postgres')\" && vitest run src/postgres --no-file-parallelism --maxWorkers=1",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:check:postgres": "tsx src/database/check.postgres.ts",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:migrate:pglite": "tsx src/database/migrate.ts",
    "db:migrate:postgres": "tsx src/database/migrate.postgres.ts",
    "db:publish-feature-flags": "tsx src/database/publish-feature-flags.postgres.ts",
    "db:seed:pglite": "tsx src/database/seed.pglite.ts",
    "db:reset:pglite": "tsx src/database/reset.pglite.ts",
    "auth:qa:seed": "tsx src/auth-qa/command.ts seed",
    "auth:qa:list": "tsx src/auth-qa/command.ts list"
  },
  "dependencies": {
    "@effect/sql-pg": "4.0.0-beta.98",
    "@effect/sql-pglite": "4.0.0-beta.98",
    "@electric-sql/pglite": "0.5.4",
    "@google-cloud/bigquery": "8.3.1",
    "@proxus/backend-domain": "workspace:*",
    "@proxus/shared": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.0-beta.98",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/pg": "8.15.5",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "3.2.7"
  }
}
