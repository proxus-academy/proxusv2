{
  "name": "@proxus/backend-infra",
  "private": true,
  "type": "module",
  "exports": {
    "./database/pglite": "./src/database/pglite.ts",
    "./database/postgres": "./src/database/postgres.ts",
    "./feature-flags/pglite": "./src/modules/feature-flags/repository.pglite.layer.ts",
    "./feature-flags/postgres": "./src/modules/feature-flags/repository.postgres.layer.ts",
    "./study-catalog/pglite": "./src/modules/study-catalog/repository.pglite.layer.ts",
    "./study-catalog/postgres": "./src/modules/study-catalog/repository.postgres.layer.ts",
    "./product-analytics/memory": "./src/modules/product-analytics/repository.memory.ts",
    "./product-analytics/bigquery": "./src/modules/product-analytics/repository.bigquery.ts",
    "./agent-harness/models/gemini": "./src/modules/agent-harness/models/gemini/layer.ts",
    "./agent-harness/store/memory": "./src/modules/agent-harness/store/memory/layer.ts",
    "./agent-harness/store/pglite": "./src/modules/agent-harness/store/pglite/layer.ts",
    "./agent-harness/store/postgres": "./src/modules/agent-harness/store/postgres/layer.ts",
    "./agent-harness/store/sql": "./src/modules/agent-harness/store/shared/layer.ts",
    "./agent-harness/skills/filesystem": "./src/modules/agent-harness/skills/filesystem/layer.ts",
    "./agent-harness/sandbox/temporary": "./src/modules/agent-harness/sandbox/temporary/layer.ts",
    "./agent-harness/sandbox/current": "./src/modules/agent-harness/sandbox/current/layer.ts",
    "./agent-harness/artifacts/filesystem": "./src/modules/agent-harness/artifacts/filesystem.ts",
    "./agent-harness/observability/console": "./src/modules/agent-harness/observability/console.ts",
    "./agent-harness/observability/inspector": "./src/modules/agent-harness/observability/inspector.ts",
    "./agent-harness/observability/otlp": "./src/modules/agent-harness/observability/otlp.ts",
    "./agent-harness/observability/trace-payload": "./src/modules/agent-harness/observability/trace-payload.ts",
    "./agent-harness/github": "./src/modules/agent-harness/github/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:check:postgres": "tsx src/database/check.postgres.ts",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:migrate:pglite": "tsx src/database/migrate.ts",
    "db:migrate:postgres": "tsx src/database/migrate.postgres.ts",
    "db:publish-feature-flags": "tsx src/database/publish-feature-flags.postgres.ts",
    "db:seed:pglite": "tsx src/database/seed.pglite.ts",
    "db:reset:pglite": "tsx src/database/reset.pglite.ts"
  },
  "dependencies": {
    "@effect/ai-openai-compat": "4.0.0-beta.98",
    "@effect/sql-pg": "4.0.0-beta.98",
    "@effect/sql-pglite": "4.0.0-beta.98",
    "@electric-sql/pglite": "0.5.4",
    "@google-cloud/bigquery": "8.3.1",
    "@proxus/agent-harness": "workspace:*",
    "@proxus/backend-domain": "workspace:*",
    "@proxus/shared": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.0-beta.98",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/pg": "8.15.5",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "3.2.7"
  }
}
