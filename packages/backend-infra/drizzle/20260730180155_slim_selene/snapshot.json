    {
      "value": "\"email_normalized\" = lower(btrim(\"email_normalized\")) and length(\"email_normalized\") <= 254 and \"email_normalized\" ~ '^[^[:space:]@]+@[^[:space:]@]+\\.[^[:space:]@]+$'",
